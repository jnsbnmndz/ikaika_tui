# Committed on purpose. The certificate subject is not a secret, and signtool refuses to
# sign when the publisher and the certificate's own subject disagree - so every machine
# has to read the same one.
#
# The share links are NOT here any more. They are secrets: .dti_configs/signing.env
# locally, DTI_CERT_SHARE_URL and DTI_DEBUG_CERT_SHARE_URL on CI. check-all fails if one
# turns up in this file again, and setup-signing moves it out.
publisher=CN=Developer Toolbox Inventory, O=DTI
